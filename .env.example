# --- Database ---
# Development: a local SQLite file.  Production: Supabase Postgres (see SUPABASE-SETUP.md).
#   Supabase, long-running server (VPS / Render / Railway): Session pooler, port 5432
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#   Supabase, serverless (Vercel): Transaction pooler, port 6543, and DATABASE_POOL_MAX=5
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=file:./hsn.db
DATABASE_POOL_MAX=10
# 64 random hex characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Member sign-in (src/lib/auth) ---
# Public address of the site, used for the Google redirect URI (e.g. https://www.example.org). Optional in development.
SITE_URL=
# Google sign-in (Google Cloud Console → OAuth client, type "Web application").
# Authorised redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email for one-time log-in codes. Without SMTP_HOST in development, codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Healthcare Sustainability Network <no-reply@example.org>"

# Admin panel account (applied by: npx payload run scripts/create-admin.ts). Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Membership is free while this is true and no PAYMENT_PROVIDER is set. Remove it to require admin approval or payment.
MEMBERSHIP_FREE=true

# --- File storage (Supabase Storage, S3-compatible). Leave S3_BUCKET empty to keep files in ./media ---
# Supabase → Storage → Settings → S3 Connection (endpoint, region) and S3 Access Keys.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Direct browser uploads on Vercel (requests there are limited to 4.5 MB). Server-side only: never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared rate limits (Upstash Redis). Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN. ---
# Without them, limits are kept per server instance in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Payments (only when membership becomes paid) ---
# PAYMENT_PROVIDER=razorpay   (or stripe)
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=
